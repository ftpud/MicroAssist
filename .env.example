ASSISTANT_TOKEN=replace-with-a-long-random-value
OPENAI_API_KEY=
HOST=127.0.0.1
PORT=3000
TIMEZONE=Europe/Riga
WORKSPACE_DIR=./workspace
BACKUP_DIR=./backups
LOG_LEVEL=info
CODEX_MODEL=gpt-5.6-terra
# Stream Codex progress, tool statuses, response chunks, and turn duration to stdout.
CODEX_VERBOSE=true

# Optional APNs push delivery. Local iOS notifications work without these.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.microassist.ftpud
APNS_KEY_PATH=
APNS_PRODUCTION=false
